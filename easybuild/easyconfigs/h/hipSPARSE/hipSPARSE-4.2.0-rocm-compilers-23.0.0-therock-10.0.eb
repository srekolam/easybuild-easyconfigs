# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipSPARSE'
version = '4.2.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/hipSPARSE'
description = """hipSPARSE is a library that contains basic linear algebra subroutines
for sparse matrices and vectors. It provides a generic API for libraries like
rocSPARSE and cuSPARSE."""
docurls = ['https://rocm.docs.amd.com/projects/hipSPARSE/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('rocSPARSE', '4.2.0'),
]

srcdir = 'projects/hipsparse'

configopts = '-DBUILD_CLIENTS_TESTS=OFF '
configopts += '-DBUILD_CLIENTS_SAMPLES=OFF '

sanity_check_paths = {
    'files': [f'lib/libhipsparse.{SHLIB_EXT}',
              'lib/cmake/hipsparse/hipsparse-config.cmake',
              'include/hipsparse/hipsparse.h'],
    'dirs': ['lib/cmake/hipsparse',
             'include/hipsparse'],
}

moduleclass = 'lib'
