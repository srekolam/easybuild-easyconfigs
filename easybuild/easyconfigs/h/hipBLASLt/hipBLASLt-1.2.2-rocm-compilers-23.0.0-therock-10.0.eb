# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipBLASLt'
version = '1.2.2'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/hipBLASLt'
description = """hipBLASLt is a library that provides general matrix-matrix operations
with a flexible API and extends functionalities beyond traditional BLAS library."""
docurls = ['https://rocm.docs.amd.com/projects/hipBLASLt/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
    ('git', '2.54.0'),
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('PyYAML', '6.0.2'),
    ('rocm-cmake', '0.14.0'),
    ('msgpack-cxx', '7.0.0'),
    ('msgpack-c', '7.0.1', '', ('GCCcore', '14.3.0')),
    ('libdivide', '6.0', '', ('GCCcore', '14.3.0')),
    ('yaml-cpp', '0.8.0', '', ('GCCcore', '14.3.0')),
    ('HIP', '10.0.0'),
    ('hipBLAS-common', '1.4.0'),
    ('amdsmi', '27.0.0', f'-therock-{_therock_version}', ('GCCcore', '14.3.0')),
    ('rocTracer', '4.1.0'),
]

# NOTE: Tensile/LayerNormGenerator requires PyYAML - must be explicitly added
# yaml-cpp and libdivide prevent FetchContent downloads during build

dependencies = [
    ('Boost', '1.88.0', '', ('GCC', '14.3.0')),
    ('BLIS', '2.0', '', ('GCC', '14.3.0')),
    ('netlib-lapack', '3.12.1', '', ('GCCcore', '14.3.0')),
    ('fmt', '11.2.0', '', ('GCCcore', '14.3.0')),
    ('spdlog', '1.15.3', '', ('GCCcore', '14.3.0')),
]

# Build from the projects/hipblaslt subdirectory
start_dir = 'projects/hipblaslt'

# Ensure PyYAML is available in PYTHONPATH during build (for Tensile/LayerNormGenerator)
_pyyaml_path = 'export PYTHONPATH=$EBROOTPYYAML/lib/python%(pyshortver)s/site-packages:$PYTHONPATH && '
preconfigopts = _pyyaml_path
prebuildopts = _pyyaml_path

# Build options as specified in AMD build scripts
# Pass hints for yaml-cpp and libdivide to avoid FetchContent downloads
configopts = '-Dyaml-cpp_DIR=$EBROOTYAMLMINCPP/lib/cmake/yaml-cpp '
configopts += '-Dlibdivide_DIR=$EBROOTLIBDIVIDE/lib/cmake/libdivide '
configopts += '-DHIPBLASLT_ENABLE_CLIENT=OFF '
configopts += '-DBUILD_CLIENTS_TESTS=OFF '
configopts += '-DBUILD_TESTING=OFF '
configopts += '-DHIPBLASLT_BUILD_TESTING=OFF '
configopts += '-DHIPBLASLT_ENABLE_OPENMP=ON '
configopts += '-DBUILD_GTEST=OFF '
configopts += '-DHIPBLASLT_BUILD_GTEST=OFF '
configopts += '-DTENSILELITE_BUILD_TESTING=OFF '
configopts += '-DHIPBLASLT_ENABLE_BLIS=ON '
configopts += '-DBLIS_INCLUDE_DIR=$EBROOTBLIS/include/blis '
configopts += '-DBLIS_LIBRARY=$EBROOTBLIS/lib/libblis.so '
# Point rocRoller assembler and Tensile compiler to amdclang++
configopts += '-DROCROLLER_ASSEMBLER_PATH=$EBROOTROCMMINLLVM/bin/amdclang++ '
configopts += '-DTensile_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang++ '
# Python for Tensile
configopts += '-DPython_ROOT=$EBROOTPYTHON '
# Limit Tensile threads to avoid OOM
configopts += '-DTensile_CPU_THREADS=%(parallel)s '

sanity_check_paths = {
    'files': [f'lib/libhipblaslt.{SHLIB_EXT}',
              'lib/cmake/hipblaslt/hipblaslt-config.cmake',
              'include/hipblaslt/hipblaslt.h'],
    'dirs': ['lib/cmake/hipblaslt',
             'include/hipblaslt'],
}

moduleclass = 'lib'
