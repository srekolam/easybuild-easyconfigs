# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipTensor'
version = '2.2.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/hipTensor'
description = """hipTensor is a library for computing tensor operations on AMD GPUs.
It provides high-performance tensor contractions and other tensor operations."""
docurls = ['https://rocm.docs.amd.com/projects/hipTensor/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('rocPRIM', '4.2.0'),
]

srcdir = 'projects/hiptensor'

configopts = '-DBUILD_CLIENTS_TESTS=OFF '
configopts += '-DBUILD_CLIENTS_BENCHMARKS=OFF '

sanity_check_paths = {
    'files': [f'lib/libhiptensor.{SHLIB_EXT}',
              'lib/cmake/hiptensor/hiptensor-config.cmake',
              'include/hiptensor/hiptensor.hpp'],
    'dirs': ['lib/cmake/hiptensor',
             'include/hiptensor'],
}

moduleclass = 'lib'
