# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipCUB'
version = '4.2.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/hipCUB'
description = """hipCUB is a thin wrapper library on top of rocPRIM or CUB that enables
developers to port a project that uses CUB library to the HIP layer."""
docurls = ['https://rocm.docs.amd.com/projects/hipCUB/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('rocPRIM', '4.2.0'),
]

srcdir = 'projects/hipcub'

sanity_check_paths = {
    'files': ['lib/cmake/hipcub/hipcub-config.cmake',
              'include/hipcub/hipcub.hpp'],
    'dirs': ['lib/cmake/hipcub',
             'include/hipcub'],
}

moduleclass = 'lib'
