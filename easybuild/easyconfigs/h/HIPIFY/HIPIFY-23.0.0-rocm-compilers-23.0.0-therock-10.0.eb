# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'HIPIFY'
version = '23.0.0'
_therock_version = '10.0'  # GitHub tag version for therock releases

homepage = 'https://github.com/ROCm/HIPIFY'
description = """HIPIFY is a set of tools that you can use to automatically
translate CUDA source code into portable HIP C++."""
docurls = ['https://rocm.docs.amd.com/projects/HIPIFY/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/HIPIFY/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'HIPIFY-therock-{_therock_version}.tar.gz',
}]
patches = ['HIPIFY-22.0.0_do-not-hardcode-compiler.patch']
checksums = [
    {'HIPIFY-therock-10.0.tar.gz': 'cd8c4722cddb4049ffb4240b3ad1aee85245abae4ccfac7d2d030e3546e72b46'},
    {'HIPIFY-22.0.0_do-not-hardcode-compiler.patch':
        '564820ee718adf21e35e36c153978deb49fee8fb15b17bbc0b7d12cc0ef555d9'},
]

builddependencies = [
    ('CMake', '3.31.8'),
]
dependencies = [
    ('Perl', '5.40.2'),
    ('zlib', '1.3.1'),
]

postinstallcmds = [
    'chmod oga+x %(installdir)s/bin/hipify-perl',
]

sanity_check_paths = {
    'files': ['bin/hipify-clang',
              'bin/hipify-perl'],
    'dirs': ['bin',
             'libexec/hipify',
             'include/hipify'],
}
sanity_check_commands = [
    'hipify-clang --version',
    'hipify-perl --version'
]

moduleclass = 'tools'
