# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipRAND'
version = '3.1.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/hipRAND'
description = """hipRAND is a thin wrapper library on top of rocRAND and cuRAND that enables
developers to port a project that uses cuRAND library to the HIP layer."""
docurls = ['https://rocm.docs.amd.com/projects/hipRAND/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('rocRAND', '4.2.0'),
]

srcdir = 'projects/hiprand'

configopts = '-DBUILD_TEST=OFF '
configopts += '-DBUILD_BENCHMARK=OFF '

sanity_check_paths = {
    'files': [f'lib/libhiprand.{SHLIB_EXT}',
              'lib/cmake/hiprand/hiprand-config.cmake',
              'include/hiprand/hiprand.h'],
    'dirs': ['lib/cmake/hiprand',
             'include/hiprand'],
}

moduleclass = 'lib'
