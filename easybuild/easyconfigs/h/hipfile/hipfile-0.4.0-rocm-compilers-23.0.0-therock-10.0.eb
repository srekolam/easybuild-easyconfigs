# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipfile'
version = '0.4.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocm-systems/tree/develop/projects/hipfile'
description = """HIPFile is a library providing file I/O operations for HIP applications.
It enables efficient file reading and writing operations in GPU-accelerated applications,
supporting both synchronous and asynchronous I/O patterns."""
docurls = ['https://rocm.docs.amd.com/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-systems-therock-{_therock_version}.tar.gz',
}]
checksums = ['f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('rocm-core', '10.0.0', f'-therock-{_therock_version}', ('GCCcore', '14.3.0')),
    ('HIP', '10.0.0'),
]

# hipfile is located in projects/hipfile within rocm-systems archive
srcdir = 'projects/%(name)s'

preconfigopts = 'ROCM_PATH=$EBROOTROCMMINCORE '

configopts = '-DBUILD_TESTS=OFF '
# Ensure RPATH is properly set
configopts += '-DCMAKE_SKIP_BUILD_RPATH=OFF '
configopts += '-DCMAKE_BUILD_WITH_INSTALL_RPATH=OFF '
configopts += '-DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON '

sanity_check_paths = {
    'files': ['lib/libhipfile.%s' % SHLIB_EXT, 'include/hipfile.h'],
    'dirs': ['lib/cmake/hipfile'],
}

moduleclass = 'lib'
