# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hip-tests'
version = '10.0.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocm-systems/tree/develop/projects/hip-tests'
description = """HIP test suite containing conformance tests, unit tests, and sample applications
for validating HIP functionality on AMD GPUs. Includes catch-based tests and sample programs
demonstrating HIP API usage."""
docurls = ['https://rocm.docs.amd.com/projects/HIP/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-systems-therock-{_therock_version}.tar.gz',
}]
checksums = ['f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
]

# hip-tests is located in projects/hip-tests within rocm-systems archive
srcdir = 'projects/hip-tests/catch'

configopts = '-DHIP_PLATFORM=amd '

sanity_check_paths = {
    'files': [],
    'dirs': ['bin', 'share'],
}

moduleclass = 'tools'
