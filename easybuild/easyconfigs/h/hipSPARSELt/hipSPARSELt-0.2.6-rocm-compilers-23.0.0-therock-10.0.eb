# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipSPARSELt'
version = '0.2.6'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/hipSPARSELt'
description = """hipSPARSELt is a SPARSE marshalling library with multiple supported backends.
It sits between the application and a worker SPARSE library, marshalling inputs
into the backend library and marshalling results back to the application."""
docurls = ['https://rocm.docs.amd.com/projects/hipSPARSELt/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('hipSPARSE', '4.2.0'),
]

srcdir = 'projects/hipsparselt'

configopts = '-DBUILD_CLIENTS_TESTS=OFF '
configopts += '-DBUILD_CLIENTS_BENCHMARKS=OFF '

sanity_check_paths = {
    'files': [f'lib/libhipsparselt.{SHLIB_EXT}',
              'lib/cmake/hipsparselt/hipsparselt-config.cmake',
              'include/hipsparselt/hipsparselt.h'],
    'dirs': ['lib/cmake/hipsparselt',
             'include/hipsparselt'],
}

moduleclass = 'lib'
