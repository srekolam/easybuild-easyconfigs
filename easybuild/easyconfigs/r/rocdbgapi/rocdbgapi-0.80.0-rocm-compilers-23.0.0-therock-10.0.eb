# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocdbgapi'
version = '0.80.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocm-systems/tree/develop/projects/rocdbgapi'
description = """ROCm Debugger API (rocdbgapi) provides the AMD GPU debugger API, which is a low-level
API for controlling the execution of GPU kernels and accessing GPU state. It is the foundation
for ROCgdb (the ROCm debugger) and other debugging tools."""
docurls = ['https://rocm.docs.amd.com/projects/ROCdbgapi/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-systems-therock-{_therock_version}.tar.gz',
}]
checksums = ['f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
]

# rocdbgapi is located in projects/rocdbgapi within rocm-systems archive
srcdir = 'projects/%(name)s'

# Enable TheRock build mode for Threads dependency from amd_comgr
configopts = '-DTHE_ROCK_BUILD=ON '

sanity_check_paths = {
    'files': ['lib/librocm-dbgapi.%s' % SHLIB_EXT],
    'dirs': ['include/amd-dbgapi', 'lib/cmake/amd-dbgapi', 'share/doc/amd-dbgapi'],
}

moduleclass = 'tools'
