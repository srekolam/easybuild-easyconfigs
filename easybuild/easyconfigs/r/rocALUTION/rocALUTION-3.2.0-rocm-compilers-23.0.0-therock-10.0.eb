# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocALUTION'
version = '3.2.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocALUTION'
description = """rocALUTION is a sparse linear algebra library with focus on exploring
fine-grained parallelism on top of AMD's ROCm platform. It provides Krylov solvers
and preconditioners for sparse matrices."""
docurls = ['https://rocm.docs.amd.com/projects/rocALUTION/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('rocBLAS', '5.2.0'),
    ('rocSPARSE', '4.2.0'),
    ('rocRAND', '4.2.0'),
    ('rocPRIM', '4.2.0'),
]

srcdir = 'projects/rocalution'

configopts = '-DBUILD_CLIENTS_TESTS=OFF '
configopts += '-DBUILD_CLIENTS_BENCHMARKS=OFF '
configopts += '-DBUILD_CLIENTS_SAMPLES=OFF '
configopts += '-DSUPPORT_HIP=ON '

sanity_check_paths = {
    'files': [f'lib/librocalution.{SHLIB_EXT}',
              'lib/cmake/rocalution/rocalution-config.cmake',
              'include/rocalution/rocalution.hpp'],
    'dirs': ['lib/cmake/rocalution',
             'include/rocalution'],
}

moduleclass = 'lib'
