# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocshmem'
version = '3.6.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocm-systems/tree/develop/projects/rocshmem'
description = """ROCm SHMEM (rocSHMEM) is an implementation of the OpenSHMEM specification
for AMD GPUs. It enables GPU-initiated communication for distributed memory parallel
programming, allowing GPU kernels to directly perform one-sided communication operations
(put/get) and collective operations across nodes in a cluster."""
docurls = ['https://rocm.docs.amd.com/projects/rocSHMEM/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-systems-therock-{_therock_version}.tar.gz',
}]
checksums = ['f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec']

builddependencies = [
    ('CMake', '3.31.8'),
    ('rocm-cmake', '0.14.0'),
    ('patchelf', '0.18.0'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('rocm-core', '10.0.0', f'-therock-{_therock_version}', ('GCCcore', '14.3.0')),
    ('rocPRIM', '4.2.0'),
    ('rocThrust', '4.2.0'),
    ('UCX', '1.19.0', '', ('GCCcore', '14.3.0')),
    ('OpenMPI', '5.0.8', '', ('GCC', '14.3.0')),
    ('elfutils', '0.193', '', ('GCCcore', '14.3.0')),
    ('libdrm', '2.4.125', '', ('GCCcore', '14.3.0')),
    ('numactl', '2.0.19', '', ('GCCcore', '14.3.0')),
]

# rocshmem is located in projects/rocshmem within rocm-systems archive
srcdir = 'projects/%(name)s'

configopts = '-DHIP_PLATFORM=amd '
configopts += '-DBUILD_SHARED_LIBS=ON '
configopts += '-DBUILD_TESTS=OFF '
configopts += '-DBUILD_EXAMPLES=OFF '
configopts += '-DUSE_SINGLE_NODE=OFF '
configopts += '-DUSE_EXTERNAL_MPI=ON '
configopts += '-DUCX_DIR=$EBROOTUCX '
configopts += '-DCMAKE_SKIP_INSTALL_RPATH=OFF '
configopts += '-DCMAKE_INSTALL_RPATH_USE_LINK_PATH=TRUE '

postinstallcmds = [
    'patchelf --force-rpath --set-rpath '
    '"$ORIGIN/../lib:$EBROOTHIP/lib:$EBROOTROCMMINLLVM/lib:'
    '$EBROOTELFUTILS/lib:$EBROOTLIBDRM/lib:$EBROOTNUMACTL/lib" '
    '%(installdir)s/bin/rocshmem_info || true',
]

sanity_check_paths = {
    'files': ['lib/librocshmem.a'],
    'dirs': ['include/rocshmem', 'lib/cmake/rocshmem'],
}

moduleclass = 'lib'
