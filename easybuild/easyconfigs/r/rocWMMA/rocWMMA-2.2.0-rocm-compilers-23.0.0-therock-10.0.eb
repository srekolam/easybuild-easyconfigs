# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocWMMA'
version = '2.2.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocWMMA'
description = """rocWMMA is a C++ library for accelerating mixed precision matrix
multiply-accumulate (MMA) operations on AMD GPUs using Wave Matrix Multiply
Accumulate (WMMA) instructions."""
docurls = ['https://rocm.docs.amd.com/projects/rocWMMA/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('rocBLAS', '5.2.0'),
]

srcdir = 'projects/rocwmma'

configopts = '-DROCWMMA_BUILD_TESTS=OFF '
configopts += '-DROCWMMA_BUILD_SAMPLES=OFF '

sanity_check_paths = {
    'files': ['lib/cmake/rocwmma/rocwmma-config.cmake',
              'include/rocwmma/rocwmma.hpp'],
    'dirs': ['lib/cmake/rocwmma',
             'include/rocwmma'],
}

moduleclass = 'lib'
