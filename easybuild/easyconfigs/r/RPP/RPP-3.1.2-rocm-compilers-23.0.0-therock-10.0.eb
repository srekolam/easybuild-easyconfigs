# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'RPP'
version = '3.1.2'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rpp'
description = """ROCm Performance Primitives (RPP) is a comprehensive high-performance
computer vision library optimized for AMD processors using HIP and OpenCL backends."""
docurls = ['https://rocm.docs.amd.com/projects/rpp/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('OpenCV', '4.11.0', '', ('GCC', '14.3.0')),
]

srcdir = 'projects/rpp'

configopts = '-DBACKEND=HIP '
configopts += '-DBUILD_TESTS=OFF '

sanity_check_paths = {
    'files': [f'lib/librpp.{SHLIB_EXT}',
              'lib/cmake/rpp/rpp-config.cmake',
              'include/rpp/rpp.h'],
    'dirs': ['lib/cmake/rpp',
             'include/rpp'],
}

moduleclass = 'lib'
