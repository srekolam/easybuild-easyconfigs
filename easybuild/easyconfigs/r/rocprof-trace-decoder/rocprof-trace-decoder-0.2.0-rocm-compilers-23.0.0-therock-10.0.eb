# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocprof-trace-decoder'
version = '0.2.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocm-systems/tree/develop/projects/rocprof-trace-decoder'
description = """ROCprof Trace Decoder is a library for decoding Advanced Thread Tracer (ATT)
traces from AMD GPUs. It provides functionality for parsing and analyzing GPU execution traces,
supporting features like virtual address to file offset translation, symbol enumeration,
and optional disassembly via amd_comgr or LLVM."""
docurls = ['https://rocm.docs.amd.com/projects/rocprofiler-sdk/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-systems-therock-{_therock_version}.tar.gz',
}]
checksums = ['f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('Python', '3.13.5'),
]

# rocprof-trace-decoder is located in projects/rocprof-trace-decoder within rocm-systems archive
srcdir = 'projects/rocprof-trace-decoder'

# Build configuration
# - Disable tests (require additional test infrastructure)
# - Use amd_comgr from ROCm-LLVM for disassembly (default)
# - Enable Python bindings
configopts = '-DBUILD_TESTS=OFF '
configopts += '-DBUILD_PYTHON=ON '
# amd_comgr is provided by ROCm-LLVM toolchain, disable LLVM direct linking
configopts += '-DUSE_LLVM_DISASM=OFF '
configopts += '-DDISABLE_COMGR=OFF '

sanity_check_paths = {
    'files': ['lib/librocprof-trace-decoder.%s' % SHLIB_EXT,
              'include/rocprof-trace-decoder/rocprof_trace_decoder/rocprof_trace_decoder.h'],
    'dirs': ['lib/cmake/rocprof-trace-decoder',
             'include/rocprof-trace-decoder/rocprof_trace_decoder/cxx'],
}

moduleclass = 'lib'
