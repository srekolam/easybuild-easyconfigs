# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'Bundle'

name = 'ROCm-LLVM'
_llvm_version = '23.0.0'
version = _llvm_version
_rocm_version = '10.0.0'
_therock_version = '10.0'  # GitHub tag version for therock releases
versionsuffix = f'-therock-{_therock_version}'

homepage = 'https://github.com/ROCm/llvm-project'
description = """ROCm-LLVM is an open source Clang/LLVM based compiler.
It is an AMD Fork of The LLVM Compiler Infrastructure, and aims to contain all of upstream LLVM.
It also includes several AMD-specific additions in the llvm-project/amd directory.
This variant includes Flang (Fortran compiler) and OpenMP offload support."""
docurls = ['https://rocmdocs.amd.com']

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('CMake', '3.31.8'),
    ('Perl', '5.40.2'),
    ('Python', '3.13.5'),
    ('PyYAML', '6.0.2'),  # required for LLVM libc header generation
    ('pkgconf', '2.4.3'),
    ('xxd', '9.1.1775'),  # required for ROCr-Runtime
    ('git', '2.50.1'),  # required for rocprofiler-register
]

dependencies = [
    ('binutils', '2.44'),
    ('elfutils', '0.193'),
    ('zlib', '1.3.1'),
    ('hwloc', '2.12.1'),
    ('GMP', '6.3.0'),
    ('libxml2', '2.14.3'),
    ('ncurses', '6.5'),
    ('libffi', '3.5.1'),
    ('libdrm', '2.4.125'),
    ('numactl', '2.0.19'),
    ('Z3', '4.15.1'),
    ('rocprofiler-register', '0.6.0', f'-ROCm-{_rocm_version}'),  # required for ROCR-Runtime
]

local_rocm_llvm_source = f'llvm-project-therock-{_therock_version}.tar.gz'
local_rocm_llvm_checksum = '92dcfe3d2e1ca52b460c7f168d8d74e47cd17370fa8bdffb919174115f94ab0f'
local_rocm_systems_source = f'rocm-systems-therock-{_therock_version}.tar.gz'
local_rocm_systems_checksum = 'f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec'
local_common_cmake_configopts = ' '.join([
    '-DCMAKE_C_COMPILER=%(installdir)s/bin/clang',
    '-DCMAKE_CXX_COMPILER=%(installdir)s/bin/clang++',
    '-DLLVM_INSTALL_PREFIX=%(installdir)s',
    '-DLLVM_DIR=%(installdir)s/lib/cmake/llvm',
    '-DROCM_DEVICE_LIBS_BITCODE_INSTALL_LOC=%(installdir)s/lib/clang/%(version_major)s/lib/amdgcn',
])

default_easyblock = 'CMakeMake'

default_component_specs = {
    'source_urls': ['https://github.com/ROCm/%(name)s/archive/'],
    'sources': [{
        'download_filename': '%(version)s.tar.gz',
        'filename': '%(name)s-%(version)s.tar.gz',
    }],
    'srcdir': '%(name)s-%(version)s',
}

components = [
    ('llvm-project', f'therock-{_therock_version}', {
        'easyblock': 'EB_ROCm_minus_LLVM',
        'sources': [
            {
                'download_filename': f'therock-{_therock_version}.tar.gz',
                'filename': local_rocm_llvm_source,
                'extract_cmd': f'tar xfz %s && mv %(name)s-therock-{_therock_version} %(name)s-therock-{_therock_version}.src',
            },
            {
                'download_filename': f'therock-{_therock_version}.tar.gz',
                'filename': f'SPIRV-LLVM-Translator-therock-{_therock_version}.tar.gz',
                'source_urls': ['https://github.com/ROCm/SPIRV-LLVM-Translator/archive/refs/tags/'],
            },
            {
                'download_filename': '0d25db97cb9b8f725e4c95e4553001710e7fc39d.tar.gz',
                'filename': 'SPIRV-Headers-0d25db97cb9b8f725e4c95e4553001710e7fc39d.tar.gz',
                'source_urls': ['https://github.com/KhronosGroup/SPIRV-Headers/archive/'],
            },
        ],
        'checksums': [
            {local_rocm_llvm_source:
                local_rocm_llvm_checksum},
            {f'SPIRV-LLVM-Translator-therock-{_therock_version}.tar.gz':
                '1c9c8caf29b60c75422736b31f0d0527a25a9da6d8d8b28e6491a44b4761a224'},
            {'SPIRV-Headers-0d25db97cb9b8f725e4c95e4553001710e7fc39d.tar.gz':
                '42d51106cc661928b0e2453fc76ef91169e8feb879fdf5a773626cd64ea6b334'},
        ],
        'preconfigopts': ' && '.join([
            f'mv %(builddir)s/SPIRV-LLVM-Translator-therock-{_therock_version} %(builddir)s/llvm-project-therock-{_therock_version}.src/llvm/projects/spirv-llvm-translator',
            f'mv %(builddir)s/SPIRV-Headers-0d25db97cb9b8f725e4c95e4553001710e7fc39d %(builddir)s/llvm-project-therock-{_therock_version}.src/spirv-headers',
            'true',
        ]) + ' && ',
        'start_dir': f'llvm-project-therock-{_therock_version}.src',
        'bootstrap': True,
        'build_lld': True,
        'build_clang_extras': True,
        'build_openmp': False,
        'build_openmp_offload': False,
        'build_openmp_tools': False,
        'build_runtimes': True,
        'full_llvm': False,
        'skip_all_tests': True,
        'skip_sanitizer_tests': True,
        'configopts': ' '.join([
            '-DLLVM_ENABLE_PROJECTS="clang;lld;clang-tools-extra;mlir;flang"',
            '-DLLVM_ENABLE_RUNTIMES="compiler-rt;libunwind"',
            #'-DLLVM_TARGETS_TO_BUILD="Native;AMDGPU;SPIRV"',
            '-DLLVM_TARGETS_TO_BUILD="AMDGPU;X86;SPIRV"',
            '-DLLVM_INCLUDE_BENCHMARKS=OFF',
            '-DLLVM_ENABLE_ASSERTIONS=OFF',
            '-DLLVM_ENABLE_RTTI=ON',
            '-DLLVM_BUILD_LLVM_DYLIB=ON',
            '-DLLVM_LINK_LLVM_DYLIB=ON',
            '-DLLVM_ENABLE_TERMINFO=OFF',
            '-DLIBOMPTARGET_BUILD_DEVICE_FORTRT=ON',
            '-DFLANG_RUNTIME_F128_MATH_LIB=libquadmath',
            '-DLIBCXX_ENABLE_SHARED=ON',
            '-DLIBCXX_ENABLE_STATIC=OFF',
            '-DLIBCXX_INSTALL_LIBRARY=ON',
            '-DLIBCXX_INSTALL_HEADERS=ON',
            '-DLIBCXXABI_ENABLE_SHARED=ON',
            '-DLIBCXXABI_ENABLE_STATIC=OFF',
            '-DLLVM_INSTALL_UTILS=ON',
            '-DLLVM_ENABLE_LIBCXX=ON',
            '-DCMAKE_Fortran_FLAGS=',
        ])
    }),
    ('ROCm-comgr', 'rocm-%s' % _rocm_version, {
        # sources are located in amd/comgr subdir of llvm-project component
        'sources': [{'filename': local_rocm_llvm_source, 'extract_cmd': 'echo %s'}],
        'checksums': [
            {local_rocm_llvm_source:
                local_rocm_llvm_checksum},
        ],
        'srcdir': f'llvm-project-therock-{_therock_version}.src/amd/comgr',
        'prebuildopts': 'export ROCM_PATH=%(installdir)s && ',
        'configopts': (local_common_cmake_configopts +
                       ' -DROCM_DIR=%(installdir)s/share/rocm/cmake')
    }),
    ('ROCR-Runtime', 'rocm-%s' % _rocm_version, {
        'source_urls': ['https://github.com/ROCm/rocm-systems/archive/'],
        'sources': [{
            'download_filename': f'therock-{_therock_version}.tar.gz',
            'filename': local_rocm_systems_source,
        }],
        'srcdir': f'rocm-systems-therock-{_therock_version}/projects/rocr-runtime',
        'checksums': [
            {local_rocm_systems_source:
                local_rocm_systems_checksum},
        ],
        'configopts': local_common_cmake_configopts + ' -DBUILD_SHARED_LIBS=ON',
    }),
    ('llvm-project-openmp', f'therock-{_therock_version}', {
        'easyblock': 'EB_ROCm_minus_LLVM',
        'sources': [
            {
                'download_filename': f'therock-{_therock_version}.tar.gz',
                'filename': local_rocm_llvm_source,
                'extract_cmd': f'tar xfz %s && mv llvm-project-therock-{_therock_version} llvm-project-%(version)s.src',
            },
            {
                'filename': local_rocm_systems_source,
                'extract_cmd': 'tar xfz %s',  # Extract ROCR sources for offload runtime
            },
        ],
        'checksums': [
            {local_rocm_llvm_source:
                local_rocm_llvm_checksum},
            {local_rocm_systems_source:
                local_rocm_systems_checksum},
        ],
        'start_dir': f'llvm-project-therock-{_therock_version}.src',
        'bootstrap': True,
        'build_lld': True,
        'build_clang_extras': False,
        'build_openmp': True,
        'build_openmp_offload': True,
        'build_openmp_tools': True,
        'build_runtimes': True,
        'full_llvm': False,
        'skip_all_tests': True,
        'skip_sanitizer_tests': True,
        'configopts': ' '.join([
            '-DLLVM_ENABLE_PROJECTS="clang;lld;flang"',
            '-DLLVM_ENABLE_RUNTIMES="compiler-rt;libunwind;openmp;offload"',
            '-DLLVM_TARGETS_TO_BUILD="AMDGPU;Native;SPIRV"',
            '-DLLVM_INCLUDE_BENCHMARKS=OFF',
            '-DRUNTIMES_CMAKE_ARGS="-DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON"',
            '-DLLVM_ENABLE_ASSERTIONS=OFF',
            '-DLLVM_ENABLE_RTTI=ON',
            '-DLLVM_BUILD_LLVM_DYLIB=ON',
            '-DLLVM_LINK_LLVM_DYLIB=ON',
            '-DLLVM_ENABLE_TERMINFO=OFF',
            '-DLIBOMPTARGET_BUILD_DEVICE_FORTRT=ON',
            '-DFLANG_RUNTIME_F128_MATH_LIB=libquadmath',
            '-DLIBCXX_ENABLE_SHARED=ON',
            '-DLIBCXX_ENABLE_STATIC=OFF',
            '-DLIBCXX_INSTALL_LIBRARY=ON',
            '-DLIBCXX_INSTALL_HEADERS=ON',
            '-DLIBCXXABI_ENABLE_SHARED=ON',
            '-DLIBCXXABI_ENABLE_STATIC=OFF',
            '-DLLVM_INSTALL_UTILS=ON',
            '-DLLVM_ENABLE_LIBCXX=ON',
            '-DOPENMP_ENABLE_LIBOMPTARGET=ON',
            '-DLIBOMPTARGET_ENABLE_DEBUG=ON',
            '-DLIBOMPTARGET_NO_SANITIZER_AMDGPU=ON',
            '-DLLVM_RUNTIME_TARGETS="default;amdgcn-amd-amdhsa"',
            #'-DRUNTIMES_amdgcn-amd-amdhsa_LLVM_ENABLE_RUNTIMES="compiler-rt;libc;libcxx;libcxxabi;flang-rt;openmp"',
            '-DRUNTIMES_amdgcn-amd-amdhsa_LLVM_ENABLE_RUNTIMES="compiler-rt;libc;openmp"',
            '-DRUNTIMES_amdgcn-amd-amdhsa_LLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON',
            '-DRUNTIMES_amdgcn-amd-amdhsa_FLANG_RT_LIBC_PROVIDER=llvm',
            '-DRUNTIMES_amdgcn-amd-amdhsa_FLANG_RT_LIBCXX_PROVIDER=llvm',
            '-DRUNTIMES_amdgcn-amd-amdhsa_LIBCXXABI_USE_LLVM_UNWINDER=OFF',
            '-DCMAKE_Fortran_FLAGS=',
        ])
    }),

]

sanity_check_components = ['llvm-project']

modextravars = {
    'HIP_DEVICE_LIB_PATH': '%(installdir)s/amdgcn/bitcode',
    'ROCM_DEVICE_LIBS_INSTALL_PREFIX_PATH': '%(installdir)s',
    'ROCM_DEVICE_LIBS_BITCODE_INSTALL_LOC': '%(installdir)s/lib/clang/%(version_major)s/lib/amdgcn',
}

moduleclass = 'tools'
