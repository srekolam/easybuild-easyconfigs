# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocPRIM'
version = '4.2.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocPRIM'
description = """rocPRIM is a header-only library that provides HIP parallel primitives.
You can use this library to develop performant GPU-accelerated code on AMD ROCm platforms."""
docurls = ['https://rocm.docs.amd.com/projects/rocPRIM/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
]

# Build from the projects/rocprim subdirectory
srcdir = 'projects/rocprim'

sanity_check_paths = {
    'files': ['lib/cmake/rocprim/rocprim-config.cmake',
              'include/rocprim/rocprim.hpp'],
    'dirs': ['lib/cmake/rocprim',
             'share/doc/rocprim',
             'include/rocprim'],
}

moduleclass = 'lib'
