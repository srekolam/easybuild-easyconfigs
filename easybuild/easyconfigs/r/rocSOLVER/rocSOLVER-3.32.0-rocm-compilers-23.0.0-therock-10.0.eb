# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocSOLVER'
version = '3.32.0'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocSOLVER'
description = """rocSOLVER is a library implementation of LAPACK routines on top of AMD's
ROCm platform. rocSOLVER is implemented in HIP and optimized for AMD GPUs."""
docurls = ['https://rocm.docs.amd.com/projects/rocSOLVER/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-libraries/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-libraries-therock-{_therock_version}.tar.gz',
}]
checksums = ['eb7f255d6627d3cfb312a7bcf41d701517ecaeac88382b56f2bde8d4947ea592']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', '10.0.0'),
    ('rocBLAS', '5.2.0'),
    ('rocSPARSE', '4.2.0'),
]

srcdir = 'projects/rocsolver'

configopts = '-DBUILD_CLIENTS_TESTS=OFF '
configopts += '-DBUILD_CLIENTS_BENCHMARKS=OFF '
configopts += '-DBUILD_CLIENTS_SAMPLES=OFF '

sanity_check_paths = {
    'files': [f'lib/librocsolver.{SHLIB_EXT}',
              'lib/cmake/rocsolver/rocsolver-config.cmake',
              'include/rocsolver/rocsolver.h'],
    'dirs': ['lib/cmake/rocsolver',
             'include/rocsolver'],
}

moduleclass = 'lib'
