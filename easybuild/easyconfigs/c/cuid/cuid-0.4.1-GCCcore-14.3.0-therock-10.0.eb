# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'CMakeMake'

name = 'cuid'
version = '0.4.1'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/rocm-systems/tree/develop/projects/cuid'
description = """CUID (Component Unified Identifier) provides deterministic, unique identifiers
for hardware devices (GPUs, CPUs, NICs) in data centers. It generates UUIDv8-style identifiers
by combining device-specific data (serial numbers, vendor IDs, device IDs) into a consistent
122-bit ID value, enabling easier device correlation and management across different tools."""
docurls = ['https://rocm.docs.amd.com/']

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': SOURCE_TAR_GZ,
}]
checksums = ['f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec']

builddependencies = [
    ('CMake', '3.31.8'),
    ('binutils', '2.44'),
]

# OpenSSL is provided by the OS or as a wrapper module
osdependencies = [OS_PKG_OPENSSL_DEV]

# cuid is located in projects/cuid within rocm-systems archive
# Archive extracts to rocm-systems-therock-10.0/
start_dir = 'projects/%(name)s'

# Build configuration
configopts = '-DBUILD_TESTS=OFF '
configopts += '-DBUILD_EXAMPLES=OFF '
configopts += '-DBUILD_DAEMON=OFF '

sanity_check_paths = {
    'files': ['lib/libamdcuid_shared.%s' % SHLIB_EXT, 'bin/amdcuid_tool'],
    'dirs': ['include/amdcuid', 'share/amdcuid'],
}

sanity_check_commands = ['amdcuid_tool --version']

moduleclass = 'tools'
