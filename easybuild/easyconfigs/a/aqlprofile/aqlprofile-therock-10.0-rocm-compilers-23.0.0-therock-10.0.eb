# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'aqlprofile'
_therock_version = '10.0'  # GitHub tag version for therock releases
version = f'therock-{_therock_version}'

homepage = 'https://github.com/ROCm/rocm-systems'
description = """
aqlprofile is part of the ROCm software stack. It provides profiling capabilities
for AMD GPU applications using the AQL (Architected Queuing Language) interface.
"""

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'rocm-systems-therock-{_therock_version}.tar.gz',
}]
checksums = ['f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('elfutils', '0.193'),
    ('libdrm', '2.4.125'),
    ('numactl', '2.0.19'),
    ('rocprofiler-register', '0.6.0', f'-therock-{_therock_version}'),
]

# aqlprofile is located in projects/aqlprofile within rocm-systems archive
srcdir = 'projects/aqlprofile'

sanity_check_paths = {
    'files': ['lib/libhsa-amd-aqlprofile64.%s' % SHLIB_EXT,
              'include/aqlprofile-sdk/aql_profile_v2.h',
              'include/aqlprofile-sdk/version.h'],
    'dirs': ['include/aqlprofile-sdk'],
}

moduleclass = 'lib'
