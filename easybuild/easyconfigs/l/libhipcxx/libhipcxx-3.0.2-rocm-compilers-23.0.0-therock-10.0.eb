# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'CMakeMake'

name = 'libhipcxx'
version = '3.0.2'
_therock_version = '10.0'

homepage = 'https://github.com/ROCm/libhipcxx'
description = """libhipcxx is the AMD HIP C++ Standard Library. It provides a
heterogeneous implementation of the C++ Standard Library that can be used in
HIP and non-HIP code."""
docurls = ['https://rocm.docs.amd.com/']

toolchain = {'name': 'rocm-compilers', 'version': f'23.0.0-therock-{_therock_version}'}

source_urls = ['https://github.com/ROCm/libhipcxx/archive/refs/tags/']
sources = [{
    'download_filename': f'therock-{_therock_version}.tar.gz',
    'filename': f'libhipcxx-therock-{_therock_version}.tar.gz',
}]
checksums = ['95a6c2eea96b99baddd0029a0dc4f64905fe7fe7b342f9dd7b1cd7795628fdeb']

builddependencies = [
    ('CMake', '3.31.8'),
    ('rocm-cmake', '0.14.0'),
]

dependencies = [
    ('HIP', '10.0.0'),
]

configopts = '-DBUILD_TESTING=OFF '
configopts += '-Dlibhipcxx_ENABLE_CMAKE_TESTS=OFF '
configopts += '-DLIBCUDACXX_ENABLE_LIBCUDACXX_TESTS=OFF '

sanity_check_paths = {
    'files': ['lib/cmake/libhipcxx/libhipcxx-config.cmake'],
    'dirs': ['include/cuda/std', 'lib/cmake/libhipcxx'],
}

moduleclass = 'lib'
